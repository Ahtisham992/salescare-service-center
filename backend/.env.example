# ====================================
# DATABASE CONFIGURATION
# ====================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salescare_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ====================================
# SERVER CONFIGURATION
# ====================================
PORT=5000
NODE_ENV=development

# ====================================
# JWT AUTHENTICATION
# ====================================
# IMPORTANT: Use a strong secret key (at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=7d

# ====================================
# APPLICATION SETTINGS
# ====================================
COMPANY_NAME=SalesCare Service Center
DEFAULT_AREA=Rawalpindi, PEL Service Center

# ====================================
# CORS (Uncomment when frontend is ready)
# ====================================
# FRONTEND_URL=http://localhost:3000

# ====================================
# EMAIL CONFIGURATION (Optional - Future)
# ====================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ====================================
# SMS CONFIGURATION (Optional - Future)
# ====================================
# SMS_API_KEY=your_sms_api_key
# SMS_SENDER_ID=SALESCARE